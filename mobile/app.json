{
  "expo": {
    "name": "Oullin",
    "slug": "oullin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#fffdf9"
    },
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que o Oullin use sua localização para cadastrar o endereço de entrega."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "br.com.oullin.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização para cadastrar o endereço de entrega."
      },
      "supportsTablet": true
    },
    "android": {
      "package": "br.com.oullin.app",
      "adaptiveIcon": {
        "backgroundColor": "#fffdf9"
      },
      "edgeToEdgeEnabled": true
    }
  }
}
